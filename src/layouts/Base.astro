---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { title, description } = Astro.props.frontmatter;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const isResume = path === '/resume';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? title} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HVM921T2TJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-HVM921T2TJ');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home">Roberto Alarcon</a>
      <nav aria-label="Main">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
        <a href="/resume" aria-current={isResume ? 'page' : undefined}>Resume</a>
      </nav>
    </header>

    <main class:list={['content', { resume: isResume, home: !isResume }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Roberto Alarcon</span>
      <span>San Diego, CA</span>
    </footer>
  </body>
</html>
